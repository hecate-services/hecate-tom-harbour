%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_tom_world

{erl_opts, [debug_info, warnings_as_errors]}.

%% ONE DEPENDENCY, and it is the substrate rather than a domain. hecate_om
%% brings the macula SDK, the realm identity, the capability advertisement and
%% the health endpoint that every hecate service boots on.
%%
%% THE WORLD IS NOT A DEPENDENCY ANY MORE, IT IS THIS. Until 2026-08-13 there
%% was a separate hecate_tom_world and a comment here in capitals swearing this
%% would never link it. The rule behind that comment was right and was being
%% enforced in the wrong place: it was written because services run on their
%% owners' laptops and a new good must not mean eight people redeploy on the same
%% afternoon. A port is not a laptop. Eight of them run two apiece on beam00 to
%% beam03, under watchtower, owned by the steward, rolled in seconds and asking
%% nobody. So the boundary the rule was policing was between the world and a
%% PLAYER, and it holds there absolutely: a player links macula and nothing of
%% ours. See hecate-tom-general/design/DESIGN_TWO_SERVICES.md.
%%
%% STORELESS. No store_id/0 and no data_dir/0 on the service module, so
%% hecate_om starts no reckon-db. What this port must not forget it keeps in its
%% own disk_log, which is OTP and needs no configuration to be durable.
{deps, [{hecate_om, "~> 0.9"}]}.

{project_plugins, [rebar3_lint]}.

%% Elvis. Same focused ruleset the rest of the org runs: structural smells
%% rather than the full erl_files set. Run via rebar3 lint.
{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["src/**/*.erl"], ruleset => macula_min}
    ]}
]}.

%% macula ships to hex without debug_info (NIF-heavy), so dialyzer cannot read
%% its Core Erlang. Exclusions kept for the day it arrives; this application's
%% own modules are analysed either way.
{dialyzer, [
    {warnings, [no_unknown]},
    {exclude_apps, [macula, macula_envy, macula_mdns, gproc, msgpack, any]}
]}.

{shell, [{apps, [hecate_tom_world]}]}.

{eunit_opts, [verbose]}.

%% ONE RELEASE, TWO PORTS. Nothing in the image says Macao: which harbour an
%% instance IS comes from TOM_HARBOUR in its environment, so the same artifact
%% runs Macao on one box and Lisbon on another and neither was rebuilt.
{relx, [
    {release, {hecate_tom_world, "0.2.0"},
     [hecate_tom_world, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true},
    %% The world, the standings and the genesis hulls travel with the release,
    %% so a place starts with nothing but an environment variable to find them.
    %% The world file is carried by every instance rather than served by one,
    %% which is what makes a place able to answer on its own.
    {overlay, [{copy, "priv/harbours", "priv/harbours"},
               {copy, "priv/ships", "priv/ships"},
               {copy, "priv/worlds", "priv/worlds"}]}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
