%% -*- mode: erlang -*-
%%
%% Traders of Macao. The world.
%%
%% Read with file:consult/1, loaded and checked by tom_world.
%%
%% This file is data, all of it. tom_shared defines the map a good is, the map a
%% harbour is and the map a recipe is, and checks that the entries below fill
%% them in. There is no vocabulary here the engine holds a closed list of. Every
%% name below can be edited without touching a line of Erlang.
%%
%% EVERY HARBOUR HAS A MARKET, and every good can be bought and sold in it at
%% the going price. So there is no list of what a harbour stocks. The only thing
%% that differs is what is PLENTIFUL there, which is what "produces" means: what
%% the hinterland makes and what the harbour's position concentrates. Plentiful
%% is cheap. Everything else is dear until somebody sails it in.
%%
%% A good says nothing about where it comes from. That is not an omission: where
%% a good comes from is the regions of the harbours that produce it, and saying
%% it twice is how the two got to disagree. Silver claimed the Americas long
%% after Acapulco started digging ore instead.
%%
%% An id is a permanent commitment. Rename one and every stored fact that ever
%% named it is orphaned.

{world, #{id => macao, name => <<"Traders of Macao">>}}.

%% Regions ---------------------------------------------------------------

{region, #{id => china,          name => <<"China">>}}.
{region, #{id => japan,          name => <<"Japan">>}}.
{region, #{id => southeast_asia, name => <<"Southeast Asia">>}}.
{region, #{id => south_asia,     name => <<"South Asia">>}}.
{region, #{id => west_asia,      name => <<"West Asia">>}}.
{region, #{id => east_africa,    name => <<"East Africa">>}}.
{region, #{id => europe,         name => <<"Europe">>}}.
{region, #{id => north_america,  name => <<"North America">>}}.
{region, #{id => south_america,  name => <<"South America">>}}.

