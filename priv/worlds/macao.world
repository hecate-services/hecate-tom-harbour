           inputs => #{gold_ore => 4, quicksilver => 1},
           outputs => #{gold => 1},
           ticks => 6}}.

%% Waypoints ------------------------------------------------------------
%%
%% Places at sea. A waypoint has no market and no hinterland; it is somewhere a
%% ship passes and can be said to be.
%%
%% A HARBOUR IS A WAYPOINT THAT HAPPENS TO HAVE A MARKET. Routes below name
%% either kind, so a route that passes a port is a route a ship may put in at,
%% and putting in costs time. That is the ship's decision to make, not the
%% world's and not the sea's.

{waypoint, #{id => formosa_strait, name => <<"Formosa Strait">>,
             at => {24.5, 119.5},
             character => <<"Shallow, crowded, and blowing hard half the "
                            "year.">>}}.
{waypoint, #{id => the_paracels, name => <<"The Paracels">>,
             at => {16.5, 112.0},
             character => <<"Reefs that have taken more ships than any "
                            "storm in these waters.">>}}.
{waypoint, #{id => luzon_strait, name => <<"Luzon Strait">>,
             at => {20.5, 121.0},
             character => <<"The door between the China Sea and the "
                            "Pacific.">>}}.
{waypoint, #{id => palawan_passage, name => <<"Palawan Passage">>,
             at => {10.5, 118.0},
             character => <<"Inside route to the south. Slow and reefy, and "
                            "out of the worst weather.">>}}.
{waypoint, #{id => the_kuroshio, name => <<"The Kuroshio">>,
             at => {33.0, 140.0},
             character => <<"The black current, which carries a ship east "
                            "whether she wants it or not.">>}}.
{waypoint, #{id => the_open_pacific, name => <<"The Open Pacific">>,
             at => {35.0, -175.0},
             character => <<"Weeks of nothing. The longest water any ship "
                            "in this trade crosses.">>}}.
{waypoint, #{id => andaman_sea, name => <<"Andaman Sea">>,
             at => {10.0, 96.0},
             character => <<"Monsoon country. It decides when you sail, not "
                            "you.">>}}.
{waypoint, #{id => laccadive_sea, name => <<"Laccadive Sea">>,
             at => {8.0, 74.0},
             character => <<"The last easy water before the Malabar "
                            "coast.">>}}.
{waypoint, #{id => mozambique_channel, name => <<"Mozambique Channel">>,
             at => {-18.0, 41.0},
             character => <<"Narrow, current-ridden, and the only sensible "
                            "way round Africa.">>}}.
{waypoint, #{id => cape_of_good_hope, name => <<"Cape of Good Hope">>,
             at => {-34.36, 18.47},
             character => <<"Named in hope by men who had rounded it once "
                            "and lived.">>}}.
{waypoint, #{id => st_helena, name => <<"St Helena">>,
             at => {-15.96, -5.72},
             character => <<"A rock with water on it, in the middle of an "
                            "ocean with none.">>}}.
{waypoint, #{id => the_doldrums, name => <<"The Doldrums">>,
             at => {3.0, -25.0},
             character => <<"No wind at all, for as long as it likes.">>}}.
{waypoint, #{id => the_canaries, name => <<"The Canaries">>,
             at => {28.3, -15.6},
             character => <<"Where the trade wind picks a ship up and takes "
                            "her west.">>}}.

%% Routes ---------------------------------------------------------------
%%
%% A route is geography: which waters lie between two ports, in order. It says
%% nothing about how long any of it takes, because that is weather, season and
%% hull, and all three are the sea's business rather than the map's.
%%
%% Routes are DIRECTIONAL. The way home was not the way out: the monsoon and the
%% trades saw to that, and a world that pretends otherwise has thrown away the
%% most interesting constraint in the period.

{route, #{id => macao_to_nagasaki, name => <<"The Great Ship to Nagasaki">>,
          from => macao, to => nagasaki, via => [formosa_strait],
          character => <<"Silk out, silver back. The shortest rich water in "
                         "the world.">>}}.
{route, #{id => nagasaki_to_macao, name => <<"Home from Nagasaki">>,
          from => nagasaki, to => macao, via => [formosa_strait],
          character => <<"The same strait, the other way, and the wind has "
                         "an opinion about it.">>}}.

{route, #{id => macao_to_manila, name => <<"Macao to Manila">>,
          from => macao, to => manila, via => [luzon_strait],
          character => <<"A week of open water to meet the galleon.">>}}.
{route, #{id => manila_to_macao, name => <<"Manila to Macao">>,
          from => manila, to => macao, via => [palawan_passage],
          character => <<"Inside the reefs, because the strait will not have "
                         "you westbound in season.">>}}.

{route, #{id => manila_to_acapulco, name => <<"The Manila Galleon">>,
          from => manila, to => acapulco,
          via => [luzon_strait, the_kuroshio, the_open_pacific],
          character => <<"North until the current takes you, then east for "
                         "as long as it lasts.">>}}.
{route, #{id => acapulco_to_manila, name => <<"The Galleon Home">>,
          from => acapulco, to => manila, via => [the_open_pacific],
          character => <<"Downwind and far quicker, which is why the "
                         "quicksilver goes west and the silver east.">>}}.

{route, #{id => macao_to_malacca, name => <<"Down to the Strait">>,
          from => macao, to => malacca, via => [the_paracels],
          character => <<"Past the reefs that have taken more ships than any "
                         "storm.">>}}.
{route, #{id => malacca_to_macao, name => <<"Up to the Pearl River">>,
          from => malacca, to => macao, via => [the_paracels],
          character => <<"The same reefs, and the same care.">>}}.

{route, #{id => malacca_to_goa, name => <<"Across the Bay">>,
          from => malacca, to => goa, via => [andaman_sea, laccadive_sea],
          character => <<"Monsoon country. It decides when you sail.">>}}.
{route, #{id => goa_to_malacca, name => <<"Back to the Strait">>,
          from => goa, to => malacca, via => [laccadive_sea, andaman_sea],
          character => <<"And it decides when you come home.">>}}.

{route, #{id => goa_to_lisbon, name => <<"The Carreira Home">>,
          from => goa, to => lisbon,
          via => [laccadive_sea, mozambique_channel, cape_of_good_hope,
                  st_helena, the_doldrums],
          character => <<"Half a year, round the Cape, and a stop at a rock "
                         "for water.">>}}.
{route, #{id => lisbon_to_goa, name => <<"The Carreira Out">>,
          from => lisbon, to => goa,
          via => [the_canaries, the_doldrums, cape_of_good_hope,
                  mozambique_channel],
          character => <<"Out with the trades, down past the calms, and "
                         "round.">>}}.

{route, #{id => lisbon_to_bahia, name => <<"The Brazil Run">>,
          from => lisbon, to => bahia, via => [the_canaries, the_doldrums],
          character => <<"West with the trade wind, and pray the calms are "
                         "short.">>}}.
{route, #{id => bahia_to_lisbon, name => <<"Home from Brazil">>,
          from => bahia, to => lisbon, via => [the_doldrums, the_canaries],
          character => <<"Sugar and tobacco, and the same calms in the "
                         "way.">>}}.
