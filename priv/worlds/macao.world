%% Recipes ---------------------------------------------------------------
%%
%% A factory is built from a recipe, and the recipe copy is destroyed in the
%% building. The town owns the factory. What the Harbour Master gets back is the
%% tax on the traffic it draws, which is why he pays for it.
%%
%% A recipe is three physical facts: what goes in, what comes out, and how long
%% a batch takes. Nothing here is money. What a batch costs in wages and fuel is
%% itself a price, and prices emerge from trade rather than being written down
%% by anybody. A fixed money number on a recipe would be an island of central
%% planning in a market game.
%%
%% Nor is a recipe ever retuned, reformulated or retired. You cannot un-invent a
%% process. A better one is a NEW recipe, published alongside the old, and the
%% old one keeps working for whoever holds a copy. Which gunpowder recipe you
%% hold starts to matter, not merely whether you can make gunpowder.
%%
%% Two recipes making the same good by different means is therefore normal.
%% Bronze cannon and iron cannon are one product out of different holds.
%%
%% A factory arbitrages against its own market, so its buying lifts the input
%% price and its selling depresses the output price until it strangles itself.
%% It only keeps earning if somebody ships the inputs in and the outputs out.
%% That is the entire reason factories are in this game.

{recipe, #{id => weave_silk, name => <<"Silk weaving">>,
           character => <<"Raw silk on the loom. The oldest money in Asia.">>,
           inputs => #{raw_silk => 2}, outputs => #{silk_piece_goods => 1},
           ticks => 4}}.

{recipe, #{id => weave_cotton, name => <<"Cotton weaving">>,
           character => <<"Plain cloth by the bolt. Dull and endless.">>,
           inputs => #{raw_cotton => 2}, outputs => #{cotton_piece_goods => 1},
           ticks => 3}}.

{recipe, #{id => full_broadcloth, name => <<"Fulling">>,
           character => <<"Wool beaten into cloth nobody in the tropics "
                          "wants.">>,
           inputs => #{wool => 2}, outputs => #{broadcloth => 1},
           ticks => 4}}.

{recipe, #{id => print_chintz, name => <<"Chintz printing">>,
           character => <<"Plain cotton and indigo become the cloth the "
                          "islands crave.">>,
           inputs => #{cotton_piece_goods => 2, indigo => 1},
           outputs => #{chintz => 2},
           ticks => 3}}.

{recipe, #{id => dye_chintz_red, name => <<"Red chintz dyeing">>,
           character => <<"The same cloth, the other colour, and a whole "
                          "ocean between the two dyes.">>,
           inputs => #{cotton_piece_goods => 2, brazilwood => 1},
           outputs => #{chintz => 2},
           ticks => 3}}.

{recipe, #{id => throw_porcelain, name => <<"Porcelain kiln">>,
           character => <<"White clay and a great deal of heat.">>,
           inputs => #{kaolin => 2}, outputs => #{porcelain => 1},
           ticks => 6}}.

{recipe, #{id => spin_cordage, name => <<"Ropewalk">>,
           character => <<"Hemp into rope. Every ship eats it.">>,
           inputs => #{hemp => 2}, outputs => #{cordage => 1},
           ticks => 2}}.

{recipe, #{id => weave_sailcloth, name => <<"Sailcloth weaving">>,
           character => <<"Canvas in bolts. A ship dare not run out.">>,
           inputs => #{hemp => 2}, outputs => #{sailcloth => 1},
           ticks => 3}}.

{recipe, #{id => mill_gunpowder, name => <<"Powder mill">>,
           character => <<"Saltpetre and sulphur, and a wide berth from "
                          "everything else.">>,
           inputs => #{saltpetre => 2, sulphur => 1},
           outputs => #{gunpowder => 2},
           ticks => 5}}.

{recipe, #{id => cast_cannon, name => <<"Gun foundry">>,
           character => <<"Copper and tin into bronze. It changes what a "
                          "harbour dares refuse.">>,
           inputs => #{copper => 3, tin => 1}, outputs => #{cannon => 1},
           ticks => 8}}.

{recipe, #{id => forge_ironwork, name => <<"Forge">>,
           character => <<"Nails, fittings, tools. Nothing gets built "
                          "without it.">>,
           inputs => #{iron => 2}, outputs => #{ironwork => 1},
           ticks => 3}}.

{recipe, #{id => dip_candles, name => <<"Chandlery">>,
           character => <<"Beeswax for churches and for temples, which is "
                          "two markets and one product.">>,
